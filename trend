      selectedCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(btn => {
        if (btn.dataset.cat === cat) {
          btn.className = 'cat-btn shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-paper-ink text-white dark:bg-white dark:text-black transition-colors';
        } else {
          btn.className = 'cat-btn shrink-0 px-3 py-1.5 rounded-full text-xs sm:text-sm font-medium text-paper-muted dark:text-obsidian-muted hover:text-paper-ink dark:hover:text-white transition-colors';
        }
      });
      renderGrid();
    }

    function selectStage(stage) {
      selectedStage = stage;
      document.querySelectorAll('.stage-btn').forEach(btn => {
        if (btn.dataset.stage === stage) {
          btn.className = 'stage-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-paper-ink text-white dark:bg-white dark:text-black transition-colors';
        } else {
          btn.className = 'stage-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium border border-paper-border dark:border-obsidian-border text-paper-muted dark:text-obsidian-muted hover:border-paper-ink transition-colors';
        }
      });
      renderGrid();
    }

    function resetFilters() {
      searchQuery = '';
      document.getElementById('searchInput').value = '';
      selectCategory('All');
      selectStage('All');
    }

    function bindEvents() {
      document.querySelectorAll('.cat-btn').forEach(btn => {
        btn.addEventListener('click', () => selectCategory(btn.dataset.cat));
      });

      document.querySelectorAll('.stage-btn').forEach(btn => {
        btn.addEventListener('click', () => selectStage(btn.dataset.stage));
      });

      document.getElementById('searchInput').addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderGrid();
      });

      // Saved Drawer controls
      document.getElementById('openSavedBtn').addEventListener('click', openSavedDrawer);
      document.getElementById('closeSavedBtn').addEventListener('click', () => {
        document.getElementById('savedDrawer').classList.add('hidden');
      });

      // Submit Trend Modal controls
      document.getElementById('openSubmitBtn').addEventListener('click', () => {
        document.getElementById('submitModal').classList.remove('hidden');
      });
      ['closeSubmitBtn', 'cancelSubmitBtn'].forEach(id => {
        document.getElementById(id).addEventListener('click', () => {
          document.getElementById('submitModal').classList.add('hidden');
        });
      });

      // Submit New Trend Form
      document.getElementById('submitTrendForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const newTrend = {
          id: 'trend-' + Date.now(),
          featured: false,
          title: document.getElementById('newTitle').value.trim(),
          category: document.getElementById('newCategory').value,
          stage: document.getElementById('newStage').value,
          growth: document.getElementById('newGrowth').value.trim(),
          author: document.getElementById('newAuthor').value.trim(),
          date: 'Nov 22, 2026',
          readTime: '3 min read',
          image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=900&q=80',
          summary: document.getElementById('newSummary').value.trim(),
          body: document.getElementById('newBody').value.trim().split('\n').filter(Boolean),
          takeaways: [
            'Community-submitted intelligence signal verified for radar tracking.',
            'Early-stage momentum indicates growing industry experimentation.'
          ],
          tags: ['Community Signal', document.getElementById('newCategory').value]
        };

        trends.unshift(newTrend);
        localStorage.setItem('tp_trends_2026', JSON.stringify(trends));
        renderTicker();
        renderGrid();
        e.target.reset();
        document.getElementById('submitModal').classList.add('hidden');
      });

      // Newsletter Form
      document.getElementById('newsletterForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.getElementById('newsletterEmail').value.trim();
        const fb = document.getElementById('newsletterFeedback');
        fb.textContent = `✓ Confirmed: ${email} is subscribed to the Sunday Intelligence Dispatch.`;
        fb.classList.remove('hidden');
        e.target.reset();
      });
    }

    // ---------------------------------------------------------------------
    // ARTICLE READER MODAL
    // ---------------------------------------------------------------------
    function openArticleModal(id) {
      const item = trends.find(t => t.id === id);
      if (!item) return;
      activeModalTrendId = id;

      document.getElementById('modalCategory').textContent = item.category;
      document.getElementById('modalVelocity').textContent = `${item.growth} (${item.stage})`;
      document.getElementById('modalTitle').textContent = item.title;
      document.getElementById('modalAuthor').textContent = `By ${item.author}`;
      document.getElementById('modalDate').textContent = item.date;
      document.getElementById('modalReadTime').textContent = item.readTime;
      document.getElementById('modalImage').src = item.image;
      document.getElementById('modalImage').alt = item.title;

      document.getElementById('modalBody').innerHTML = item.body.map(p => `<p>${p}</p>`).join('');
      document.getElementById('modalTakeaways').innerHTML = (item.takeaways || []).map(t => `<li>${t}</li>`).join('');

      updateModalBookmarkButton();
      document.getElementById('articleModal').classList.remove('hidden');
    }

    function closeArticleModal() {
      document.getElementById('articleModal').classList.add('hidden');
      activeModalTrendId = null;
    }

    function updateModalBookmarkButton() {
      if (!activeModalTrendId) return;
      const btn = document.getElementById('modalBookmarkBtn');
      const isSaved = savedIds.includes(activeModalTrendId);
      btn.textContent = isSaved ? '★ Saved in List' : '☆ Save Briefing';
      btn.onclick = () => {
        toggleBookmark(activeModalTrendId);
        updateModalBookmarkButton();
      };
    }

    // ---------------------------------------------------------------------
    // BOOKMARKS & SAVED DRAWER
    // ---------------------------------------------------------------------
    function toggleBookmark(id) {
      if (savedIds.includes(id)) {
        savedIds = savedIds.filter(item => item !== id);
      } else {
        savedIds.push(id);
      }
      localStorage.setItem('tp_saved_2026', JSON.stringify(savedIds));
      updateSavedBadge();
      renderHero();
      renderGrid();
      if (!document.getElementById('savedDrawer').classList.contains('hidden')) {
        renderSavedList();
      }
    }

    function updateSavedBadge() {
      document.getElementById('savedCountBadge').textContent = savedIds.length;
    }

    function openSavedDrawer() {
      renderSavedList();
      document.getElementById('savedDrawer').classList.remove('hidden');
    }

    function renderSavedList() {
      const container = document.getElementById('savedListContainer');
      const savedTrends = trends.filter(t => savedIds.includes(t.id));

      if (savedTrends.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 space-y-2">
            <p class="font-display font-bold">Your reading list is empty</p>
            <p class="text-xs text-paper-muted dark:text-obsidian-muted">Bookmark any trend brief to save it locally for offline reading.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = savedTrends.map(item => `
        <div class="p-4 rounded-xl border border-paper-border dark:border-obsidian-border bg-paper-bg dark:bg-obsidian-bg space-y-2">
          <div class="flex items-center justify-between text-[11px] font-mono">
            <span class="text-brand-accent font-semibold">${item.category}</span>
            <span class="text-emerald-500">${item.growth}</span>
          </div>
          <h4 onclick="document.getElementById('savedDrawer').classList.add('hidden'); openArticleModal('${item.id}')" class="font-display font-bold text-sm cursor-pointer hover:text-brand-light">
            ${item.title}
          </h4>
          <div class="flex items-center justify-between pt-1">
            <span class="text-[11px] font-mono text-paper-muted">${item.readTime}</span>
            <button onclick="toggleBookmark('${item.id}')" class="text-xs text-red-500 hover:underline">Remove</button>
          </div>
        </div>
      `).join('');
    }

    // ---------------------------------------------------------------------
    // PUBLISHER INFO MODALS (ABOUT, METHODOLOGY, ADSENSE, CONTACT, PRIVACY)
    // ---------------------------------------------------------------------
